# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/stock_analysis

# JWT Secret
JWT_SECRET=super_secret_jwt_key_stock_analysis_2026_dev
JWT_EXPIRES_IN=7d

# 0xramm Indian Stock Market API (defaults to http://127.0.0.1:5000 with automatic Yahoo Finance fallback)
INDIAN_STOCK_API_URL=http://127.0.0.1:5000

# Google Gemini AI API Key for What-If Scenario Analysis
GEMINI_API_KEY=your_gemini_api_key_here
